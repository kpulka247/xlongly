{
    "manifest_version": 3,
    "name": "xLongly",
    "version": "0.0.0",
    "description": "Converts written posts on X and Bluesky that exceed the character limit into images with text.",
    "permissions": [
        "storage",
        "tabs",
        "notifications"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.x.com/*",
                "*://*.twitter.com/*",
                "*://*.bsky.app/*"
            ],
            "js": [
                "content-script.js"
            ],
            "css": [
                "styles/main.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "xLongly Settings",
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "xlongly@kpulka.com",
            "strict_min_version": "109.0"
        }
    }
}